<Window x:Class="food.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="餐廳收藏" Height="820" Width="1240" MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 卡片：白底、細框、大圓角；陰影放在另一層（見 CardShadow），避免內文被模糊 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.07" Color="#431407"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 輸入框上的灰色提示文字：輸入框為空時才顯示 -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 分類前面的展開 / 收合箭頭 -->
        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource FieldIconButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <!-- 餐廳清單項目：彩色頭像 + 名稱 + 分類路徑 + 星等 -->
        <DataTemplate x:Key="RestaurantTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{Binding AvatarColor}">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Stars}" FontSize="13" Foreground="{DynamicResource StarBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,22,28,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 標題列 ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <!-- 工具列：一條白色膠囊裡放幾個透明按鈕 -->
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <!-- 主題：按一下依序切換 跟隨系統 → 淺色 → 深色（圖示與提示文字由程式設定） -->
                    <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Padding="10,8" Click="Theme_Click">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE770;"/>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" ToolTip="把所有分類與餐廳存成 Excel 檔" Click="Export_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="匯出 Excel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" ToolTip="從 Excel 檔匯入分類與餐廳" Click="Import_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="匯入 Excel"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" ToolTip="在桌面建立（或修復）捷徑" Click="Shortcut_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="桌面捷徑"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="CheckUpdate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="檢查更新"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentGradient}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.25" Color="#EA580C"/>
                </Border.Effect>
                <TextBlock Text="🍜" FontFamily="Segoe UI Emoji" FontSize="22" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="餐廳收藏" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,1,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== 主內容 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- 最左：分類（全部餐廳 / 國家 › 縣市 › 地區） -->
            <Border Grid.Column="0" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,16,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="6,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,5" FontSize="12"
                                ToolTip="新增一個國家" Click="AddCountry_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="新增國家"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="分類" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="CategoryList" Grid.Row="1" Style="{StaticResource FolderListStyle}" SelectionMode="Single"
                             SelectionChanged="CategoryList_SelectionChanged" MouseDoubleClick="CategoryList_MouseDoubleClick"
                             ContextMenuOpening="CategoryList_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu/>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Indent}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 箭頭：有子分類才顯示；沒有時保留空位，名稱才會對齊 -->
                                    <Grid Width="22" Visibility="{Binding ShowArrowColumn, Converter={StaticResource BoolToVis}}">
                                        <Button Content="{Binding Arrow}" Style="{StaticResource ArrowButton}" Click="Toggle_Click"
                                                ToolTip="展開 / 收合"
                                                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" Margin="4,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding Tooltip}"/>
                                    <TextBlock x:Name="CountLabel" Grid.Column="3" Text="{Binding Count}" FontSize="12" Margin="8,0,4,0"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <!-- 滑過分類時，數字換成「新增下一層 / 重新命名 / 刪除」按鈕 -->
                                    <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,0">
                                        <Button Content="&#xE710;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="11"
                                                ToolTip="{Binding AddTip}" Click="AddChild_Click"
                                                Visibility="{Binding CanAddChild, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="&#xE70F;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="12"
                                                ToolTip="重新命名" Click="RenameCategory_Click"/>
                                        <Button Content="&#xE74D;" Style="{StaticResource IconButton}" FontSize="12"
                                                ToolTip="刪除" Click="DeleteCategory_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                            <Condition Binding="{Binding IsCategory}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="CountLabel" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 中：搜尋 + 餐廳清單 -->
            <Border Grid.Column="2" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" Padding="38,9,12,9" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource SubtleBrush}"
                                   Margin="14,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="搜尋名稱、地址、電話、備註…" Margin="40,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 目前所在的分類 -->
                    <TextBlock x:Name="BreadcrumbText" Grid.Row="1" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,10"
                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>

                    <ListBox x:Name="RestaurantList" Grid.Row="2" Style="{StaticResource EntryListStyle}"
                             ItemTemplate="{StaticResource RestaurantTemplate}" SelectionMode="Single"
                             SelectionChanged="RestaurantList_SelectionChanged"/>

                    <!-- 空清單提示 -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="26"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyText" TextAlignment="Center" LineHeight="20"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=RestaurantList}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：編輯 -->
            <Border Grid.Column="4" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,20,20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="餐廳資料" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="餐廳名稱 *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NameBox" Margin="0,0,0,14" MaxLength="100"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="國家 *" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CountryBox" Padding="10,8,28,8" DisplayMemberPath="Display" SelectedValuePath="Id"
                                              SelectionChanged="CountryBox_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="縣市" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CityBox" Padding="10,8,28,8" DisplayMemberPath="Display" SelectedValuePath="Id"
                                              SelectionChanged="CityBox_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="地區" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="DistrictBox" Padding="10,8,28,8" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="地址" Style="{StaticResource FieldLabel}"/>
                            <!-- 地址欄右側：在 Google 地圖開啟 -->
                            <Grid Margin="0,0,0,14">
                                <TextBox x:Name="AddressBox" Padding="12,8,42,8" MaxLength="200"/>
                                <Button Content="&#xE707;" Style="{StaticResource FieldIconButton}" ToolTip="在 Google 地圖開啟"
                                        HorizontalAlignment="Right" Margin="0,0,4,0" Click="OpenMap_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="電話" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PhoneBox" MaxLength="40"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="評分" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="RatingBox" DisplayMemberPath="Display" SelectedValuePath="Value"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="備註" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NoteBox" Height="110" AcceptsReturn="True" MaxLength="2000"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 操作按鈕固定在卡片底部，表單再長也不會被捲出畫面 -->
                    <UniformGrid Grid.Row="2" Columns="3" Rows="1" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Padding="10,10" Click="Add_Click"
                                ToolTip="把表單內容新增成一間餐廳">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="新增"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="5,0,5,0" Padding="10,10" Click="Save_Click" ToolTip="儲存對選取餐廳的修改">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="儲存"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Margin="5,0,0,0" Padding="10,10" Click="Delete_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="刪除"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 頁尾 ===== -->
        <DockPanel Grid.Row="2" Margin="4,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" FontSize="12" Padding="12,6" Click="ClearForm_Click"
                    ToolTip="清空右側表單，準備新增下一間">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="清空表單"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
