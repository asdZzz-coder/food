<Window x:Class="food.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="餐廳收藏" Height="840" Width="1280" MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 卡片：白底、細框、大圓角；陰影放在另一層（見 CardShadow），避免內文被模糊 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.08" Color="#431407"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 輸入框上的灰色提示文字：輸入框為空時才顯示 -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 小膠囊標籤（標題列的統計、清單的數量） -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- 表單的分區標題：小字 + 一條細線 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,10,0"/>
        </Style>

        <!-- 分類前面的展開 / 收合箭頭 -->
        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource FieldIconButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <!-- 評分的星星按鈕（顏色由程式依目前分數設定） -->
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Content" Value="★"/>
            <Setter Property="Foreground" Value="{DynamicResource StarEmptyBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StarSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 餐廳清單項目：漸層頭像 + 名稱 / 分類標籤 / 地址電話 + 評分標籤 -->
        <DataTemplate x:Key="RestaurantTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="14" Background="{Binding AvatarBrush}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <!-- 有備註時名稱旁邊多一個小圖示 -->
                        <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="11" Margin="8,2,0,0"
                                   Foreground="{DynamicResource SubtleBrush}" ToolTip="有備註"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,2" Margin="0,5,0,0"
                            Background="{DynamicResource AccentSoftBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PathText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="1,5,0,0"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="999" Padding="9,3" VerticalAlignment="Top" Margin="0,2,2,0"
                        Background="{DynamicResource StarSoftBrush}"
                        Visibility="{Binding HasRating, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="★" FontSize="12" Foreground="{DynamicResource StarBrush}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding RatingText}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 頂端淡淡的橘色光暈，往下漸漸消失 -->
        <Border Height="260" VerticalAlignment="Top" Background="{DynamicResource AccentSoftBrush}" IsHitTestVisible="False">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <Grid Margin="28,22,28,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 標題列 ===== -->
            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <!-- 工具列：一條白色膠囊裡放幾個透明按鈕 -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <!-- 主題：按一下依序切換 跟隨系統 → 淺色 → 深色（圖示與提示文字由程式設定） -->
                        <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Padding="10,8" Click="Theme_Click">
                            <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE770;"/>
                        </Button>
                        <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                        <Button Style="{StaticResource GhostButton}" ToolTip="把所有分類與餐廳存成 Excel 檔" Click="Export_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="匯出 Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" ToolTip="從 Excel 檔匯入分類與餐廳" Click="Import_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="匯入 Excel"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                        <Button Style="{StaticResource GhostButton}" ToolTip="在桌面建立（或修復）捷徑" Click="Shortcut_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="桌面捷徑"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="CheckUpdate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="檢查更新"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 標題圖示：與程式圖示相同的碗和筷子（向量繪製，任何縮放都清楚） -->
                <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource AccentGradient}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#EA580C"/>
                    </Border.Effect>
                    <Viewbox Width="38" Height="38">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M10,11.2 L17.2,3.6 M12.2,11.6 L19.4,5.2"/>
                            <Path Fill="White" Data="M3.4,11 H20.6 V12.4 H3.4 Z M4.4,12.4 H19.6 A7.6,7 0 0 1 4.4,12.4 Z M9.6,19.2 H14.4 V20.6 H9.6 Z"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold">
                        <Run Text="餐廳收藏"/>
                        <Run Text="  收藏每一間想再去的店" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/>
                    </TextBlock>
                    <!-- 統計：幾間餐廳 / 幾個國家 / 幾個分類 -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource Pill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,1,6,0"/>
                                <TextBlock x:Name="RestaurantCountText" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,1,6,0"/>
                                <TextBlock x:Name="CountryCountText" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,1,6,0"/>
                                <TextBlock x:Name="CategoryCountText" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- ===== 主內容 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>

                <!-- 最左：分類（全部餐廳 / 國家 › 縣市 › 地區） -->
                <Border Grid.Column="0" Style="{StaticResource CardShadow}"/>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,16,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="6,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="12"
                                    Foreground="{DynamicResource AccentBrush}" ToolTip="新增一個國家" Click="AddCountry_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="新增國家" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="分類" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="CategoryList" Grid.Row="1" Style="{StaticResource FolderListStyle}" SelectionMode="Single"
                                 SelectionChanged="CategoryList_SelectionChanged" MouseDoubleClick="CategoryList_MouseDoubleClick"
                                 ContextMenuOpening="CategoryList_ContextMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu/>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{Binding Indent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 箭頭：有子分類才顯示；沒有時保留空位，名稱才會對齊 -->
                                        <Grid Width="22" Visibility="{Binding ShowArrowColumn, Converter={StaticResource BoolToVis}}">
                                            <Button Content="{Binding Arrow}" Style="{StaticResource ArrowButton}" Click="Toggle_Click"
                                                    ToolTip="展開 / 收合"
                                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" Margin="4,0,9,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Tooltip}"/>
                                        <!-- 數量：圓角小標籤 -->
                                        <Border x:Name="CountLabel" Grid.Column="3" CornerRadius="999" Padding="8,1" Margin="8,0,2,0" MinWidth="26"
                                                VerticalAlignment="Center" Background="{DynamicResource HoverBrush}">
                                            <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <!-- 滑過分類時，數字換成「新增下一層 / 重新命名 / 刪除」按鈕 -->
                                        <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,0">
                                            <Button Content="&#xE710;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="11"
                                                    ToolTip="{Binding AddTip}" Click="AddChild_Click"
                                                    Visibility="{Binding CanAddChild, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="&#xE70F;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="12"
                                                    ToolTip="重新命名" Click="RenameCategory_Click"/>
                                            <Button Content="&#xE74D;" Style="{StaticResource IconButton}" FontSize="12"
                                                    ToolTip="刪除" Click="DeleteCategory_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="CountLabel" Property="Background" Value="{DynamicResource CardBrush}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                <Condition Binding="{Binding IsCategory}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="CountLabel" Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 操作提示 -->
                        <Border Grid.Row="2" CornerRadius="10" Padding="10,8" Margin="0,10,0,0" Background="{DynamicResource InputBgBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                                           VerticalAlignment="Top" Margin="0,2,8,0"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="17" MaxWidth="210"
                                           Text="滑過分類可新增下一層、改名或刪除；按右鍵也可以。雙擊可展開或收合。"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 中：目前分類 + 搜尋 + 餐廳清單 -->
                <Border Grid.Column="2" Style="{StaticResource CardShadow}"/>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 目前所在的分類（大字）＋ 餐廳數 -->
                        <DockPanel Margin="2,0,4,12">
                            <Border DockPanel.Dock="Right" CornerRadius="999" Padding="10,3" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock x:Name="ListCountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock x:Name="BreadcrumbText" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,4,12">
                            <TextBox x:Name="SearchBox" Padding="38,9,12,9" TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource SubtleBrush}"
                                       Margin="14,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="搜尋名稱、地址、電話、備註…" Margin="40,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ListBox x:Name="RestaurantList" Grid.Row="2" Style="{StaticResource EntryListStyle}"
                                 ItemTemplate="{StaticResource RestaurantTemplate}" SelectionMode="Single"
                                 SelectionChanged="RestaurantList_SelectionChanged"/>

                        <!-- 空清單提示 -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="76" Height="76" CornerRadius="24" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="30"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EmptyText" TextAlignment="Center" LineHeight="22" FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=RestaurantList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右：編輯 -->
                <Border Grid.Column="4" Style="{StaticResource CardShadow}"/>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,18,20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 標題：新增餐廳 / 編輯餐廳（由程式切換） -->
                        <DockPanel Margin="0,0,0,14">
                            <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock x:Name="FormIcon" Text="&#xE710;" Style="{StaticResource Icon}" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FormTitle" Text="新增餐廳" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FormSubtitle" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,8,0">
                                <!-- 基本資料 -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="基本資料" Style="{StaticResource SectionTitle}"/>
                                    <Border Height="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="餐廳名稱 *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NameBox" Margin="0,0,0,16" MaxLength="100"/>

                                <!-- 位置 -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="位置" Style="{StaticResource SectionTitle}"/>
                                    <Border Height="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="國家 *" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CountryBox" Padding="10,8,28,8" DisplayMemberPath="Display" SelectedValuePath="Id"
                                                  SelectionChanged="CountryBox_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="縣市" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CityBox" Padding="10,8,28,8" DisplayMemberPath="Display" SelectedValuePath="Id"
                                                  SelectionChanged="CityBox_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="地區" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="DistrictBox" Padding="10,8,28,8" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="地址" Style="{StaticResource FieldLabel}"/>
                                <!-- 地址欄右側：在 Google 地圖開啟 -->
                                <Grid Margin="0,0,0,18">
                                    <TextBox x:Name="AddressBox" Padding="12,8,42,8" MaxLength="200"/>
                                    <Button Content="&#xE8A7;" Style="{StaticResource FieldIconButton}" ToolTip="在 Google 地圖開啟"
                                            HorizontalAlignment="Right" Margin="0,0,4,0" Click="OpenMap_Click"/>
                                </Grid>

                                <!-- 聯絡與評價 -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="聯絡與評價" Style="{StaticResource SectionTitle}"/>
                                    <Border Height="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="電話" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="PhoneBox" MaxLength="40"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <TextBlock x:Name="RatingLabel" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                       Margin="8,0,2,6" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="評分" Style="{StaticResource FieldLabel}"/>
                                        </DockPanel>
                                        <!-- 五顆星：點第幾顆就是幾分，再點一次同一顆可清除 -->
                                        <StackPanel x:Name="StarPanel" Orientation="Horizontal" Margin="-4,0,0,0" MouseLeave="StarPanel_MouseLeave">
                                            <Button Style="{StaticResource StarButton}" Tag="1" Click="Star_Click" MouseEnter="Star_MouseEnter" ToolTip="1 顆星"/>
                                            <Button Style="{StaticResource StarButton}" Tag="2" Click="Star_Click" MouseEnter="Star_MouseEnter" ToolTip="2 顆星"/>
                                            <Button Style="{StaticResource StarButton}" Tag="3" Click="Star_Click" MouseEnter="Star_MouseEnter" ToolTip="3 顆星"/>
                                            <Button Style="{StaticResource StarButton}" Tag="4" Click="Star_Click" MouseEnter="Star_MouseEnter" ToolTip="4 顆星"/>
                                            <Button Style="{StaticResource StarButton}" Tag="5" Click="Star_Click" MouseEnter="Star_MouseEnter" ToolTip="5 顆星"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="備註" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NoteBox" Height="84" AcceptsReturn="True" MaxLength="2000"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 操作按鈕固定在卡片底部，表單再長也不會被捲出畫面 -->
                        <UniformGrid Grid.Row="2" Columns="3" Rows="1" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Padding="10,11" Click="Add_Click"
                                    ToolTip="把表單內容新增成一間餐廳">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="新增"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="5,0,5,0" Padding="10,11" Click="Save_Click" ToolTip="儲存對選取餐廳的修改">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="儲存"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Margin="5,0,0,0" Padding="10,11" Click="Delete_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="刪除"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 頁尾 ===== -->
            <DockPanel Grid.Row="2" Margin="4,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenFolderButton" Style="{StaticResource GhostButton}" FontSize="12" Padding="12,6" Click="OpenDataFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="開啟資料夾"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" FontSize="12" Padding="12,6" Click="ClearForm_Click"
                            ToolTip="清空右側表單，準備新增下一間">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="清空表單"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
